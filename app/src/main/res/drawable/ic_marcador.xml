<?xml version="1.0" encoding="utf-8"?>
<!--
    Marcador ROJO que ponemos en el mapa sobre el lugar elegido.
    La punta del marcador está abajo al centro: por eso en Kotlin le
    decimos al Marker que se "ancle" en ANCHOR_CENTER, ANCHOR_BOTTOM.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Cuerpo del marcador, con borde blanco para que resalte sobre el mapa. -->
    <path
        android:fillColor="#E53935"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1"
        android:pathData="M12,1.5C7.86,1.5 4.5,4.86 4.5,9c0,5.6 7.5,13.5 7.5,13.5s7.5,-7.9 7.5,-13.5c0,-4.14 -3.36,-7.5 -7.5,-7.5z" />
    <!-- Círculo blanco del centro. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,9m-2.8,0a2.8,2.8 0,1 1,5.6 0a2.8,2.8 0,1 1,-5.6 0" />
</vector>
